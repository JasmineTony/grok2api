{
  "name": "grok2api-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:chunks": "node scripts/check-chunk-cycles.mjs",
    "profile:devtools": "node scripts/profile-chrome-devtools-mcp.mjs",
    "check:icons": "node scripts/check-icon-imports.mjs",
    "test:e2e": "playwright test",
    "lint:fix": "eslint . --fix",
    "test:coverage": "vitest run --coverage",
    "audit:unused": "node scripts/run-knip.mjs",
    "audit:code": "node scripts/audit-codebase.mjs",
    "audit:api-contracts": "node scripts/audit-admin-api-contracts.mjs",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm profile:summary && pnpm check:icons && pnpm check:ui-symbols && pnpm check:bundle && pnpm check:chunks && pnpm audit:unused && pnpm audit:code && pnpm audit:api-contracts && pnpm audit:architecture && pnpm audit:duplicates",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:architecture": "node scripts/audit-architecture.mjs",
    "audit:duplicates": "jscpd src --config .jscpd.json",
    "profile:summary": "node scripts/write-performance-summary.mjs",
    "check:ui-symbols": "node scripts/check-ui-symbols.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@shadcn/react": "^0.2.1",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.9",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "recharts": "3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint-react/eslint-plugin": "5.18.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.9.0",
    "jscpd": "^5.0.14",
    "jsdom": "29.1.1",
    "knip": "6.31.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.15.0 <12"
  }
}
